#!/bin/bash
#PBS -q regular-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=gc64
#PBS -j oe
#PBS -N pivot_prof_sk9

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K_CLIQUE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
GTAP_ROOT="$(cd "$K_CLIQUE_DIR/../../.." && pwd)"
KCGPU_DIR="${KCGPU_DIR:-$GTAP_ROOT/../KCGPU}"
GRAPH="${GRAPH:-$KCGPU_DIR/graphs/as-Skitter/as-Skitter.mtx}"
cd "$K_CLIQUE_DIR"
PROF=profile

MAKE_ARGS=$(python3 scripts/load_gtap_graph_k_config.py --make-args pivot as-Skitter 9 | tr '\n' ' ')
# heavy/second/third from config CSV
read -r HEAVY SECOND THIRD _ORIENT_MTP _PIVOT_MTP < <(python3 scripts/load_gtap_graph_k_config.py --values as-Skitter 9)
# shellcheck disable=SC2086
make -B gtap_pivot GTAP_ENABLE_PROFILING=1   GTAP_K_HEAVY_CANDIDATES="$HEAVY"   GTAP_K_SECOND_HEAVY_CANDIDATES="$SECOND"   GTAP_K_THIRD_HEAVY_CANDIDATES="$THIRD"   $MAKE_ARGS

mkdir -p "$PROF"
# The binary writes a current-format profile under ./profile/k_clique_pivot.
./bin/gtap_pivot "$GRAPH" 9

# Regenerate paper figure
python3 "$GTAP_ROOT/evaluation/scripts/plot_k_clique_pivot_timeline_paper.py"

python3 - <<'PY'
import json
from pathlib import Path
p = Path("profile/k_clique_pivot/profile.json")
with p.open(encoding="utf-8") as stream:
    profile = json.load(stream)
summary = profile["task_execution"]
print(f"as-Skitter k9 intervals={summary['intervals']['recorded_count']}")
PY
