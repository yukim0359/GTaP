#!/bin/bash
#PBS -q regular-g
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -W group_list=gc64
#PBS -j oe
#
# GTAP orientation: render warp-profile PDFs from ./profile/ CSVs
# (run gtap_orientation with GTAP_ENABLE_PROFILING=1 first).
#
# Usage:
#   qsub run_gtap_orientation_profile_figures.pbs

cd "${PBS_O_WORKDIR:-$(cd "$(dirname "$0")/.." && pwd)}"

python3 scripts/k_clique_visualize_profile.py \
  --variant orientation \
  --worker "${WORKER:-both}" \
  --mode "${MODE:-both}" \
  --format "${FORMAT:-pdf}"
