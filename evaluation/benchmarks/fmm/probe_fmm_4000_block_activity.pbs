#!/bin/bash
#PBS -q regular-g
#PBS -l select=1
#PBS -l walltime=01:30:00
#PBS -W group_list=gc64
#PBS -j oe
#PBS -N fmm_4000_prof
#
# Answer: of the launched GTAP_GRID_SIZE=4000 blocks (1 warp/block), how many
# actually execute DTT tasks for paper N=5e7 theta=0.2?
#
# Builds GTAP_ENABLE_PROFILING-enabled fmm_profile with paper 1.5x caps, runs once, summarizes
# profile/task_execution_aggregates.csv.
#
#   qsub probe_fmm_4000_block_activity.pbs
# Optional: qsub -v N=50000000,THETA=0.2,GTAP_PROFILE_CAPACITY=1000 ...

set -euo pipefail

if [ -n "${PBS_O_WORKDIR:-}" ]; then
  cd "$PBS_O_WORKDIR"
else
  cd "$(dirname "${BASH_SOURCE[0]}")"
fi

# shellcheck source=fmm_dtt_theta_build_defs.sh
source ./fmm_dtt_theta_build_defs.sh

N="${N:-50000000}"
THETA="${THETA:-0.2}"
# Keep sample buffer modest: we only need active vs idle per warp.
GTAP_PROFILE_CAPACITY="${GTAP_PROFILE_CAPACITY:-1000}"

fmm_dtt_apply_build_defs "$THETA" "$N"
# Ensure env override cannot silently shrink/grow the paper default.
export GTAP_MAX_TASKS_PER_WARP="${GTAP_MAX_TASKS_PER_WARP}"

echo "=== FMM 4000-block activity profile ==="
date
hostname
nvidia-smi -L || true
nvidia-smi --query-gpu=memory.total,memory.free --format=csv || true
echo "N=${N} THETA=${THETA}"
fmm_dtt_print_build_defs
echo "  GTAP_GRID_SIZE=4000 GTAP_BLOCK_SIZE=32 GTAP_PROFILE_CAPACITY=${GTAP_PROFILE_CAPACITY}"

OUT_DIR="bin/profile_N${N}_theta$(python3 -c "t=format(float('${THETA}'), 'f').rstrip('0'); t=t[:-1] if t.endswith('.') else t; print(t.replace('.', ''))")"
mkdir -p "$OUT_DIR" profile csv

echo "=== Build fmm_profile ==="
make -B OUT_DIR="$(pwd)/${OUT_DIR}" \
  GTAP_MAX_TASKS_PER_WARP="${GTAP_MAX_TASKS_PER_WARP}" \
  FMM3D_DTT_M2L_CAP="${FMM3D_DTT_M2L_CAP}" \
  FMM3D_DTT_P2P_CAP="${FMM3D_DTT_P2P_CAP}" \
  GTAP_PROFILE_CAPACITY="${GTAP_PROFILE_CAPACITY}" \
  fmm_profile

BIN="${OUT_DIR}/fmm_profile"
if [[ ! -x "$BIN" ]]; then
  echo "Missing $BIN" >&2
  exit 1
fi

echo "=== Run ${BIN} ${N} ${THETA} ==="
# Do not leave GTAP_MAX_TASKS_PER_WARP unset; binary default matches make define.
log="csv/fmm_4000_block_activity_N${N}_theta${THETA}.log"
set +e
"$BIN" "$N" "$THETA" >"$log" 2>&1
rc=$?
set -e
tail -n 80 "$log"
echo "(full log: ${log}, rc=${rc})"

STATS="profile/task_execution_aggregates.csv"
if [[ ! -f "$STATS" ]]; then
  echo "Missing profile stats: $STATS" >&2
  exit 1
fi

# Archive with run stamp so we do not confuse with June stale profile.
stamp=$(date +%Y%m%d_%H%M%S)
ARCHIVE="profile/task_execution_aggregates_N${N}_theta${THETA}_${stamp}.csv"
cp -f "$STATS" "$ARCHIVE"
echo "Archived stats -> ${ARCHIVE}"

python3 - <<'PY' "$STATS" "$ARCHIVE" "$log" "$rc"
import sys
from pathlib import Path
import pandas as pd

stats_path, archive, log_path, rc = sys.argv[1:5]
df = pd.read_csv(stats_path)
n = len(df)
active = df[df["tasks_executed"] > 0]
idle = df[df["tasks_executed"] == 0]
recorded = df[df["intervals_recorded"] > 0]
active_duration_ms = active["recorded_task_execution_ns"] / 1_000_000.0

summary = Path("csv/fmm_4000_block_activity_summary.txt")
lines = []
lines.append(f"rc={rc}")
lines.append(f"stats={archive}")
lines.append(f"n_warps={n} warp_id=[{df['warp_id'].min()}..{df['warp_id'].max()}]")
lines.append(f"active_tasks_executed>0={len(active)} ({100*len(active)/n:.2f}%)")
lines.append(f"idle_tasks_executed==0={len(idle)} ({100*len(idle)/n:.2f}%)")
lines.append(f"recorded_intervals>0={len(recorded)} ({100*len(recorded)/n:.2f}%)")
lines.append(f"sum_tasks_executed={int(df['tasks_executed'].sum())}")
lines.append(f"sum_intervals_recorded={int(df['intervals_recorded'].sum())}")
lines.append(f"sum_intervals_dropped={int(df['intervals_dropped'].sum())}")
if len(active):
    lines.append("recorded_task_execution_ms_active: "
                 + active_duration_ms.describe().to_string().replace("\n", " | "))
    lines.append(f"tasks_executed_active mean={active['tasks_executed'].mean():.1f} "
                 f"min={int(active['tasks_executed'].min())} "
                 f"max={int(active['tasks_executed'].max())}")
# Parse launch config from log if present
text = Path(log_path).read_text(errors="replace")
for key in ("GTaP config:", "GTaP runtime allocation:", "DTT core traversal:",
            "GTaP profile written", "Task ID pool exhausted"):
    for line in text.splitlines():
        if key in line:
            lines.append(line.strip())
            break

summary.write_text("\n".join(lines) + "\n")
print("\n=== SUMMARY ===")
print("\n".join(lines))
PY

date
exit "$rc"
