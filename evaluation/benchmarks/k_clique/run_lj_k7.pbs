#!/bin/bash
#PBS -q regular-g
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -W group_list=gc64
#PBS -j oe

cd "${PBS_O_WORKDIR:-$(cd "$(dirname "$0")" && pwd)}"

K_CLIQUE_DIR=$(pwd)
GTAP_ROOT=$(cd "$K_CLIQUE_DIR/../../.." && pwd)
WORK_ROOT=$(cd "$GTAP_ROOT/.." && pwd)
KCGPU_DIR=${KCGPU_DIR:-"$WORK_ROOT/KCGPU"}
GRAPH_PATH=${GRAPH_PATH:-"$KCGPU_DIR/graphs/com-LiveJournal/com-LiveJournal.mtx"}

if [ ! -f "$GRAPH_PATH" ]; then
    echo "ERROR: graph not found: $GRAPH_PATH" >&2
    echo "Set GRAPH_PATH or KCGPU_DIR to locate com-LiveJournal.mtx" >&2
    exit 1
fi

./bin/gtap_pivot "$GRAPH_PATH" 7
