        <mxCell id="left-summary" value="&#8226; Up to 32 tasks are concurrently executed in a warp.&lt;br&gt;&#8226; Programmers write each task in a sequential manner.&lt;br&gt;&#8226; Inter-task warp divergence can occur." style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1C2D3C;fontSize=16;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
